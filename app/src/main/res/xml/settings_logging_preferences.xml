<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/preference_category_header_logging">

        <SwitchPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:defaultValue="false"
            android:key="@string/pref_key_logs"
            android:title="@string/use_logs"
            app:summary="@string/use_logs_summary" />

        <SwitchPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:defaultValue="false"
            android:dependency="@string/pref_key_logs"
            android:key="@string/pref_key_log_headers"
            android:title="@string/use_log_headers"
            app:summary="@string/use_log_headers_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_header_rclone">

        <ListPreference
            android:defaultValue="1s"
            android:key="@string/pref_key_stats_interval"
            android:title="@string/pref_stats_interval_title"
            android:entries="@array/pref_stats_interval_entries"
            android:entryValues="@array/pref_stats_interval_values"
            app:summary="@string/pref_stats_interval_summary"
            app:useSimpleSummaryProvider="true" />

        <de.felixnuesse.extract.settings.preferences.ButtonPreference
            android:title="@string/pref_send_sigquit_title"
            app:summary="@string/pref_send_sigquit_summary"
            android:key="TempKeySigquit" />
    </PreferenceCategory>
</PreferenceScreen>